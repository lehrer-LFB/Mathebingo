# Mathebingo – Umgebungsvariablen (nur Platzhalter, keine echten Werte ins Repo!)
# Testsystem: PORT=3000 (im Image gesetzt), lokal: 3005
PORT=3005
# Präfix, unter dem alles ausgeliefert wird (Caddy entfernt ihn nicht)
BASE_PATH=/mathebingo
# Gemeinsames Secret aller Apps aus der Server-.env bzw. der lokalen Portal-.env – niemals loggen oder committen
AUTH_SECRET=hier-das-gemeinsame-AUTH_SECRET-eintragen
# Erlaubte Origins für den WebSocket (kommagetrennt). Testsystem: https://webapps.das-rsg.de
ALLOWED_ORIGINS=http://localhost:3005
# true blendet den gelben Testsystem-Hinweis ein
TESTSYSTEM=
